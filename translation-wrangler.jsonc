{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goodthings-translation-indexer",
  "main": "translation-indexer.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["47 */6 * * *"]
  },
  "vars": {
    "FEED_DATA_URL": "https://goodthingstoknowtoday.pages.dev/data/feeds.json",
    "LOCALE_CATALOG_URL": "https://goodthingstoknowtoday.pages.dev/locales.json",
    "TRANSLATION_DAILY_ITEM_QUOTA": "100"
  },
  "d1_databases": [
    {
      "binding": "TRANSLATION_DB",
      "database_name": "newsaggregator-views",
      "database_id": "f3b66d75-d780-4657-aacf-d21f4538b035"
    }
  ]
}
